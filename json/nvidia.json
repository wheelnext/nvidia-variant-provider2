                      "op": "format",
                      "template": "{major}",
                      "args": {
                        "major": {
                          "op": "ref",
                          "name": "major"
                        }
                      }
                    },
                    "else": {
                      "op": "format",
                      "template": "{major}.{minor}",
                      "args": {
                        "major": {
                          "op": "ref",
                          "name": "major"
                        },
                        "minor": {
                          "op": "ref",
                          "name": "minor"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "upper": {
      "cache": false,
      "expr": {
        "op": "let",
        "bindings": [
          {
            "name": "version",
            "value": {
              "op": "query",
              "name": "umd_version"
            }
          }
        ],
        "body": {
          "op": "if",
          "condition": {
            "op": "is_null",
            "value": {
              "op": "ref",
              "name": "version"
            }
          },
          "then": {
            "op": "literal",
            "value": []
          },
          "else": {
            "op": "let",
            "bindings": [
              {
                "name": "vmajor",
                "value": {
                  "op": "version_part",
                  "value": {
                    "op": "ref",
                    "name": "version"
                  },
                  "part": "major"
                }
              },
              {
                "name": "vminor",
                "value": {
                  "op": "version_part",
                  "value": {
                    "op": "ref",
                    "name": "version"
                  },
                  "part": "minor"
                }
              }
            ],
            "body": {
              "op": "flatten",
              "value": {
                "op": "map",
                "items": {
                  "op": "range",
                  "start": {
                    "op": "const",
                    "name": "umd_max_major"
                  },
                  "stop": {
                    "op": "binary",
                    "kind": "sub",
                    "left": {
                      "op": "ref",
                      "name": "vmajor"
                    },
                    "right": {
                      "op": "literal",
                      "value": 1
                    }
                  },
                  "step": {
                    "op": "literal",
                    "value": -1
                  }
                },
                "var": "major",
                "body": {
                  "op": "map",
                  "items": {
                    "op": "if",
                    "condition": {
                      "op": "binary",
                      "kind": "gt",
                      "left": {
                        "op": "ref",
                        "name": "major"
                      },
                      "right": {
                        "op": "ref",
                        "name": "vmajor"
                      }
                    },
                    "then": {
                      "op": "concat",
                      "items": [
                        {
                          "op": "range",
                          "start": {
                            "op": "const",
                            "name": "umd_max_minor"
                          },
                          "stop": {
                            "op": "literal",
                            "value": -1
                          },
                          "step": {
                            "op": "literal",
                            "value": -1
                          }
                        },
                        {
                          "op": "list",
                          "items": [
                            {
                              "op": "literal",
                              "value": null
                            }
                          ]
                        }
                      ]
                    },
                    "else": {
                      "op": "range",
                      "start": {
                        "op": "const",
                        "name": "umd_max_minor"
                      },
                      "stop": {
                        "op": "ref",
                        "name": "vminor"
                      },
                      "step": {
                        "op": "literal",
                        "value": -1
                      }
                    }
                  },
                  "var": "minor",
                  "body": {
                    "op": "if",
                    "condition": {
                      "op": "is_null",
                      "value": {
                        "op": "ref",
                        "name": "minor"
                      }
                    },
                    "then": {
                      "op": "format",
                      "template": "{major}",
                      "args": {
                        "major": {
                          "op": "ref",
                          "name": "major"
                        }
                      }
                    },
                    "else": {
                      "op": "format",
                      "template": "{major}.{minor}",
                      "args": {
                        "major": {
                          "op": "ref",
                          "name": "major"
                        },
                        "minor": {
                          "op": "ref",
                          "name": "minor"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "supported_sm": {
      "cache": false,
      "expr": {
        "op": "let",
        "bindings": [
          {
            "name": "architecture",
            "value": {
              "op": "query",
              "name": "sm_architectures"
            }
          }
        ],
        "body": {
          "op": "if",
          "condition": {
            "op": "ref",
            "name": "architecture"
          },
          "then": {
            "op": "let",
            "bindings": [
              {
                "name": "parts",
                "value": {
                  "op": "unpack",
                  "value": {
                    "op": "ref",
                    "name": "architecture"
                  },
                  "count": 2
                }
              },
              {
                "name": "major",
                "value": {
                  "op": "index",
                  "value": {
                    "op": "ref",
                    "name": "parts"
                  },
                  "index": {
                    "op": "literal",
                    "value": 0
                  }
                }
              },
              {
                "name": "minor",
                "value": {
                  "op": "index",
                  "value": {
                    "op": "ref",
                    "name": "parts"
                  },
                  "index": {
                    "op": "literal",
                    "value": 1
                  }
                }
              }
            ],
            "body": {
              "op": "if",
              "condition": {
                "op": "binary",
                "kind": "lt",
                "left": {
                  "op": "parse_version",
                  "value": {
                    "op": "format",
                    "template": "{major}.{minor}",
                    "args": {
                      "major": {
                        "op": "ref",
                        "name": "major"
                      },
                      "minor": {
                        "op": "ref",
                        "name": "minor"
                      }
                    }
                  }
                },
                "right": {
                  "op": "parse_version",
                  "value": {
                    "op": "format",
                    "template": "{major}.0",
                    "args": {
                      "major": {
                        "op": "const",
                        "name": "sm_min_major"
                      }
                    }
                  }
                }
              },
              "then": {
                "op": "seq",
                "items": [
                  {
                    "op": "warn",
                    "diagnostic": "old_sm",
                    "args": {
                      "major": {
                        "op": "ref",
                        "name": "major"
                      },
                      "minor": {
                        "op": "ref",
                        "name": "minor"
                      }
                    }
                  },
                  {
                    "op": "literal",
                    "value": []
                  }
                ]
              },
              "else": {
                "op": "concat",
                "items": [
                  {
                    "op": "map",
                    "items": {
                      "op": "range",
                      "start": {
                        "op": "ref",
                        "name": "minor"
                      },
                      "stop": {
                        "op": "literal",
                        "value": -1
                      },
                      "step": {
                        "op": "literal",
                        "value": -1
                      }
                    },
                    "var": "minor_digit",
                    "body": {
                      "op": "format",
                      "template": "{major}{minor}_real",
                      "args": {
                        "major": {
                          "op": "ref",
                          "name": "major"
                        },
                        "minor": {
                          "op": "ref",
                          "name": "minor_digit"
                        }
                      }
                    }
                  },
                  {
                    "op": "list",
                    "items": [
                      {
                        "op": "format",
                        "template": "{major}0_virtual",
                        "args": {
                          "major": {
                            "op": "ref",
                            "name": "major"
                          }
                        }
                      }
                    ]
                  }
                ]
              }
            }
          },
          "else": {
            "op": "literal",
            "value": []
          }
        }
      }
    },
    "supported_configs": {
      "cache": true,
      "expr": {
        "op": "if",
        "condition": {
          "op": "is_null",
          "value": {
            "op": "query",
            "name": "umd_version"
          }
        },
        "then": {
          "op": "literal",
          "value": []
        },
        "else": {
          "op": "configs",
          "mode": "supported"
        }
      }
    },
    "all_configs": {
      "cache": true,
      "expr": {
        "op": "configs",
        "mode": "all"
      }
    }
  },
  "features": [
    {
      "name": "cuda_version_lower_bound",
      "multi_value": false,
      "all": "all_umd",
      "supported": "lower"
    },
    {
      "name": "cuda_version_upper_bound",
      "multi_value": false,
      "all": "all_umd",
      "supported": "upper"
    },
    {
      "name": "sm_arch",
      "multi_value": true,
      "all": "all_sm",
      "supported": "supported_sm"
    }
  ],
  "exports": {
    "generate_all_umd_values": "all_umd",
    "generate_all_sm_values": "all_sm",
    "umd_version": "umd_version",
    "get_sm_architectures": "sm_architectures",
    "get_supported_configs": "supported_configs",
    "get_all_configs": "all_configs"
  },
  "diagnostics": {
    "missing_umd": {
      "category": "UserWarning",
      "message": "No UMD version found. NVIDIA platform is not supported or properly installed on this machine."
    },
    "outside_umd": {
      "category": "UserWarning",
      "message": "The UMD version `{version}` is outside the supported range: `>={minimum},<={maximum}`.\nNVIDIA platform detection has been deactivated."
    },
    "old_sm": {
      "category": "UserWarning",
      "message": "The SM version is lower than the lowest SM architecture supported by the NVIDIA Variant Plugin: {major}.{minor}. NVIDIA platform detection may not work as expected."
    }
  }
}
